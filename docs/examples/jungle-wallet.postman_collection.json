      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('runId', Date.now().toString(36) + Math.random().toString(36).slice(2, 8));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('access_token present', () => pm.expect(j.access_token).to.be.a('string').and.not.empty);",
              "pm.environment.set('internalToken', j.access_token);"
            ]
          }
        }
      ]
