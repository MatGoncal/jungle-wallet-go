    {
      "name": "04 Open wallet with positive balance",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function guid() {",
              "  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {",
              "    const r = Math.random() * 16 | 0;",
              "    const v = c === 'x' ? r : (r & 0x3 | 0x8);",
              "    return v.toString(16);",
              "  });",
              "}",
              "pm.environment.set('playerId', guid());",
              "pm.environment.set('externalTransactionId', 'bet-' + pm.environment.get('runId'));",
              "pm.environment.set('refundExternalTransactionId', 'refund-' + pm.environment.get('runId'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('wallet id', () => pm.expect(j.id).to.be.a('string').and.not.empty);",
              "pm.test('balance 1000.00 BRL', () => {",
              "  pm.expect(j.balance.amount).to.eql('1000.00');",
              "  pm.expect(j.balance.currency).to.eql('BRL');",
              "});",
              "pm.environment.set('walletId', j.id);",
              "pm.environment.set('playerId', j.playerId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{internalToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": {\"amount\": \"1000.00\", \"currency\": \"BRL\"}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/wallets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "wallets"
          ]
        }
      }
    },
