# HTTP API (container interno :8080; host publicado em 18080)
HTTP_ADDR=:8080
API_URL=http://localhost:18080

# PostgreSQL (host 55432 evita conflito com outros Postgres locais)
DATABASE_URL=postgres://wallet:wallet@localhost:55432/wallet?sslmode=disable
MIGRATE_DATABASE_URL=postgres://wallet:wallet@localhost:55432/wallet?sslmode=disable

# AWS / LocalStack (SQS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wallet-events.fifo

# OIDC (Keycloak — host publicado no Compose)
OIDC_ISSUER_URL=http://localhost:8081/realms/jungle-wallet
# Em Compose a API usa discovery interno; no host deixe vazio (mesmo que o issuer).
OIDC_DISCOVERY_URL=
OIDC_AUDIENCE=

# Keycloak token endpoint (scripts / make token)
KEYCLOAK_TOKEN_URL=http://localhost:8081/realms/jungle-wallet/protocol/openid-connect/token
KEYCLOAK_PROVIDER_CLIENT_ID=provider-a
KEYCLOAK_PROVIDER_CLIENT_SECRET=provider-a-secret
KEYCLOAK_INTERNAL_CLIENT_ID=internal-service
KEYCLOAK_INTERNAL_CLIENT_SECRET=internal-service-secret

# Lifecycle
SHUTDOWN_TIMEOUT=15s
READY_CHECK_TIMEOUT=2s

# Keycloak admin (somente ambiente local Compose)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
